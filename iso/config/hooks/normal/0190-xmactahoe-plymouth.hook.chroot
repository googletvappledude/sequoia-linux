#!/bin/sh
# Install XMacTahoe Plymouth animation only; preserve Sequoia login and sound.
set -e
XMT_VERSION="7ffdaab099220c603c39fbb4503739beee17768c"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
apt-get install -y --no-install-recommends plymouth-themes git ca-certificates
git -C "$WORK/XMacTahoe" init
git -C "$WORK/XMacTahoe" remote add origin https://github.com/chapdel/XMacTahoe.git
git -C "$WORK/XMacTahoe" fetch --depth 1 origin "$XMT_VERSION"
git -C "$WORK/XMacTahoe" checkout --detach FETCH_HEAD
THEME="$WORK/XMacTahoe/extra/plymouth/xmactahoe"
[ -s "$THEME/xmactahoe.plymouth" ] || { echo "ERROR: XMacTahoe Plymouth theme files are missing" >&2; exit 1; }
install -d /usr/share/plymouth/themes/xmactahoe
cp -a "$THEME/." /usr/share/plymouth/themes/xmactahoe/
install -d /usr/share/doc/sequoia-xmactahoe-plymouth
install -m 0644 "$WORK/XMacTahoe/LICENSE" /usr/share/doc/sequoia-xmactahoe-plymouth/copyright
