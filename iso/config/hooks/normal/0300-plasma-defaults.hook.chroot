
#!/bin/sh
set -e

# Install Sequoia Plasma widgets
for d in /usr/share/sequoia/kpackages/plasmoids/*; do
  [ -d "$d" ] && mkdir -p /usr/share/plasma/plasmoids && cp -r "$d" /usr/share/plasma/plasmoids/
done

# Install Sequoia wallpapers
for d in /usr/share/sequoia/kpackages/wallpapers/*; do
  [ -d "$d" ] && mkdir -p /usr/share/plasma/wallpapers && cp -r "$d" /usr/share/plasma/wallpapers/
done

# Install Sequoia look-and-feel themes
for d in /usr/share/sequoia/kpackages/look-and-feel/*; do
  [ -d "$d" ] && mkdir -p /usr/share/plasma/look-and-feel && cp -r "$d" /usr/share/plasma/look-and-feel/
done

# Enable essential services
systemctl enable sddm.service
systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable sequoia-boot-sound.service

# Enable automatic login only for the live USB. The service checks /run/live,
# so installed systems continue to use the normal password-protected SDDM screen.
systemctl enable sequoia-live-autologin.service

# Enable the startup sound for user sessions
systemctl --global enable sequoia-startup-sound.service
