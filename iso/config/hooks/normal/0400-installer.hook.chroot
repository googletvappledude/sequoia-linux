
#!/bin/sh
# Prepare the installer: remove the live user from installed systems,
# disable automated LUKS partitioning, and set GRUB defaults.

set -e

C=/etc/calamares

echo "[installer] calamares config tree:"
ls -R "$C" 2>/dev/null | head -80 || true

echo "[installer] exec sequence in settings.conf:"
grep -nE '^\s*-\s+[a-z]' "$C/settings.conf" 2>/dev/null | head -60 || true

# Create the removeuser configuration
mkdir -p "$C/modules"

cat > "$C/modules/removeuser.conf" <<'EOF'
username: live
EOF

echo "[installer] removeuser.conf:"
cat "$C/modules/removeuser.conf"

# Disable automated LUKS partitioning
if [ -f "$C/modules/partition.conf" ]; then
    sed -i '/^enableLuksAutomatedPartitioning:/d' "$C/modules/partition.conf"
    echo "enableLuksAutomatedPartitioning: false" >> "$C/modules/partition.conf"
fi

# GRUB defaults for the installed system
# Hidden menu with a 2-second window to reveal it using Shift/Esc.
cat > /etc/default/grub <<'GRUBDEF'
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=2
GRUB_DISTRIBUTOR="Sequoia Linux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0 vt.global_cursor_default=0 plymouth.ignore-serial-consoles"
GRUB_CMDLINE_LINUX=""
GRUB_GFXPAYLOAD_LINUX=keep
GRUBDEF

echo "[installer] Calamares configuration prepared."
echo "[installer] GRUB defaults configured."
