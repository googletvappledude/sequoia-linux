#!/bin/sh
# Prepare Calamares to remove the live account from the installed system.
set -e
R="${SEQUOIA_ROOT:-}"
C="$R/etc/calamares"
M="$C/modules"

echo "[installer] calamares config tree:"; ls -R "$C" 2>/dev/null | head -80 || true
echo "[installer] exec sequence in settings.conf:"; grep -nE '^\\s*-\\s+[a-z]' "$C/settings.conf" 2>/dev/null | head -60 || true

# Debian's calamares-settings-debian does not enable the removeuser job by
# default. Install its module config and add it to the exec sequence explicitly.
mkdir -p "$M"
cat > "$M/removeuser.conf" <<'REMOVEUSER'
---
username: live
REMOVEUSER

if [ -f "$C/settings.conf" ]; then
  if ! grep -Eq '^[[:space:]]*-[[:space:]]*removeuser[[:space:]]*$' "$C/settings.conf"; then
    # Run after user creation, while the installer is still operating in target.
    if grep -qE '^[[:space:]]*-[[:space:]]*umount[[:space:]]*$' "$C/settings.conf"; then
      sed -i '/^[[:space:]]*-[[:space:]]*umount[[:space:]]*$/i\      - removeuser' "$C/settings.conf"
    else
      echo "[installer] ERROR: could not find umount in Calamares exec sequence" >&2
      exit 1
    fi
  fi
else
  echo "[installer] ERROR: $C/settings.conf not found" >&2
  exit 1
fi

echo "[installer] removeuser.conf:"; cat "$M/removeuser.conf"
echo "[installer] removeuser sequence entry:"; grep -n removeuser "$C/settings.conf"

if [ -f "$M/partition.conf" ]; then
  sed -i '/^enableLuksAutomatedPartitioning:/d' "$M/partition.conf"
  echo "enableLuksAutomatedPartitioning: false" >> "$M/partition.conf"
fi

# Password page: the dictionary check needs cracklib's word list; also let the user continue past a weak-password warning.
update-cracklib >/dev/null 2>&1 || true
if [ -f "$M/users.conf" ]; then
  sed -i '/^allowWeakPasswords/d' "$M/users.conf"
  printf 'allowWeakPasswords: true\nallowWeakPasswordsDefault: false\n' >> "$M/users.conf"
  echo "[installer] users.conf weak-password settings:"; grep -n 'allowWeak' "$M/users.conf"
else
  echo "[installer] WARNING: $M/users.conf not found"
fi

# GRUB defaults used by the INSTALLED system: hidden menu (hold Shift/Esc during the 2 s window to show it), splash on.
mkdir -p "$R/etc/default"
cat > "$R/etc/default/grub" <<'GRUBDEF'
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=2
GRUB_DISTRIBUTOR="Sequoia Linux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0 vt.global_cursor_default=0 plymouth.ignore-serial-consoles"
GRUB_CMDLINE_LINUX=""
GRUB_GFXPAYLOAD_LINUX=keep
GRUBDEF
