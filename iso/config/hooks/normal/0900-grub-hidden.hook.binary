#!/bin/sh
# Replace the generated GRUB config with a hidden, instant-boot entry (black screen, no menu).
set -e
CFG=binary/boot/grub/grub.cfg
[ -f "$CFG" ] || { echo "grub.cfg missing" >&2; exit 1; }
cat > "$CFG" <<'GRUB'
set default=0
set timeout=0
set timeout_style=hidden
set gfxpayload=keep
set color_normal=black/black
set color_highlight=black/black
insmod all_video
terminal_output gfxterm
menuentry "Sequoia Linux" {
  linux  /live/vmlinuz boot=live components quiet splash loglevel=0 rd.systemd.show_status=false rd.udev.log_level=0 vt.global_cursor_default=0 plymouth.ignore-serial-consoles username=live
  initrd /live/initrd.img
}
GRUB
