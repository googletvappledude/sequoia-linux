#!/bin/sh
# Make GRUB boot instantly with a black screen. Prints diagnostics if the layout is unexpected.
set -e
echo "[grub-hidden] cwd=$(pwd)"
B=.; [ -d binary ] && B=binary
echo "[grub-hidden] using tree: $B"
CFG="$B/boot/grub/grub.cfg"
if [ ! -f "$CFG" ]; then
  echo "[grub-hidden] WARNING: $CFG not found; grub*.cfg files present:"
  find "$B" -maxdepth 4 -name 'grub*.cfg' 2>/dev/null || true
  echo "[grub-hidden] tree of $B (depth 3):"
  find "$B" -maxdepth 3 2>/dev/null | head -80 || true
  echo "[grub-hidden] live-build bootloader templates:"
  ls /usr/share/live/build/bootloaders 2>/dev/null || true
  mkdir -p "$B/boot/grub"
fi
echo "[grub-hidden] /live contents:"; ls "$B/live" 2>/dev/null || true
cat > "$CFG" <<'GRUB'
set default=0
set timeout=0
set timeout_style=hidden
set gfxpayload=keep
set color_normal=black/black
set color_highlight=black/black
search --no-floppy --set=root --file /live/initrd.img
menuentry "Sequoia Linux" {
  linux  /live/vmlinuz boot=live components quiet splash loglevel=0 rd.systemd.show_status=false rd.udev.log_level=0 vt.global_cursor_default=0 plymouth.ignore-serial-consoles username=live
  initrd /live/initrd.img
}
GRUB
echo "[grub-hidden] wrote $CFG"
