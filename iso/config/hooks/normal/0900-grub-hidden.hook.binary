#!/bin/sh
# Hidden, instant-boot GRUB entry. Kernel/initrd names are DETECTED (live-build adds the kernel version).
set -e
echo "[grub-hidden] cwd=$(pwd)"
B=.; [ -d binary ] && B=binary
CFG="$B/boot/grub/grub.cfg"
LIVE="$B/live"
echo "[grub-hidden] /live contents:"; ls -la "$LIVE" 2>/dev/null || true
KERNEL=$(ls "$LIVE" 2>/dev/null | grep -E '^vmlinuz' | sort -V | tail -n1)
INITRD=$(ls "$LIVE" 2>/dev/null | grep -E '^initrd' | sort -V | tail -n1)
if [ -z "$KERNEL" ] || [ -z "$INITRD" ]; then
  echo "[grub-hidden] ERROR: kernel or initrd not found in $LIVE" >&2; exit 1
fi
echo "[grub-hidden] using kernel=$KERNEL initrd=$INITRD"
if [ ! -f "$CFG" ]; then
  echo "[grub-hidden] WARNING: $CFG not found; creating it. grub*.cfg present:"
  find "$B" -maxdepth 4 -name 'grub*.cfg' 2>/dev/null || true
  mkdir -p "$B/boot/grub"
fi
cat > "$CFG" <<GRUB
set default=0
set timeout=0
set timeout_style=hidden
set gfxpayload=keep
set color_normal=black/black
set color_highlight=black/black
search --no-floppy --set=root --file /live/$INITRD
menuentry "Sequoia Linux" {
  linux  /live/$KERNEL boot=live components quiet splash loglevel=0 rd.systemd.show_status=false rd.udev.log_level=0 vt.global_cursor_default=0 plymouth.ignore-serial-consoles username=live
  initrd /live/$INITRD
}
GRUB
echo "[grub-hidden] wrote $CFG:"; cat "$CFG"
