#!/bin/bash
# Plays the startup sound at most once per boot, per user.
# Overrides (for tests): SEQUOIA_SOUND, SEQUOIA_PLAYER, SEQUOIA_BOOT_ID, SEQUOIA_STATE_DIR, SEQUOIA_CONF, SEQUOIA_WAIT
set -u
SOUND="${SEQUOIA_SOUND:-/usr/share/sequoia/startup-sound.wav}"
CONF="${SEQUOIA_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/sequoia/startup-sound.conf}"
STATE="${SEQUOIA_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sequoia}"
BOOT_ID="${SEQUOIA_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)}"
WAIT="${SEQUOIA_WAIT:-20}"
mkdir -p "$STATE"

# 1. Preference (default enabled). File format: enabled=true|false
if [ -f "$CONF" ] && grep -qiE '^\s*enabled\s*=\s*(false|0|no|off)\s*$' "$CONF"; then
  echo "startup sound disabled by user"; exit 0
fi
# 2. Sound file must exist
[ -r "$SOUND" ] || { echo "sound file missing: $SOUND" >&2; exit 1; }
# 3. Only real user sessions (no greeter, no root)
[ "$(id -u)" -ne 0 ] || [ -n "${SEQUOIA_PLAYER:-}" ] || exit 0
[ -n "${XDG_SESSION_TYPE:-}" ] || [ -n "${SEQUOIA_PLAYER:-}" ] || { echo "no graphical session"; exit 0; }

# 4. Duplicate prevention: lock + boot_id marker (survives panel/audio/service restarts)
exec 9>"$STATE/startup-sound.lock"
flock -n 9 || { echo "another instance running"; exit 0; }
MARK="$STATE/startup-sound.boot_id"
if [ -f "$MARK" ] && [ "$(cat "$MARK")" = "$BOOT_ID" ]; then
  echo "already played this boot"; exit 0
fi

# 5. Wait for audio server + a default sink (skipped when a test player is injected)
if [ -z "${SEQUOIA_PLAYER:-}" ]; then
  ok=0
  for _ in $(seq 1 $((WAIT * 4))); do
    if wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; then ok=1; break; fi
    sleep 0.25
  done
  [ "$ok" = 1 ] || { echo "audio not ready after ${WAIT}s; not playing (will retry next session start)" >&2; exit 0; }
  sleep 0.5   # let the sink settle to avoid clipped first samples
fi

# 6. Play exactly once. Mark BEFORE playing so a crash/restart cannot replay.
echo "$BOOT_ID" > "$MARK"
if [ -n "${SEQUOIA_PLAYER:-}" ]; then
  "$SEQUOIA_PLAYER" "$SOUND"
elif command -v pw-play >/dev/null; then pw-play "$SOUND"
elif command -v paplay >/dev/null; then paplay "$SOUND"
else aplay -q "$SOUND"; fi
